# Telegram API credentials - Get these from https://my.telegram.org
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Control bot token from @BotFather (the menu you chat with to manage rules)
BOT_TOKEN=your_bot_token_here

# Telegram user IDs allowed to use the bot, comma separated (send /id to the bot to see yours)
ADMIN_IDS=123456789

# Login of the forwarding account. Generate it with: python generate_session.py
# Required on a server. Locally you can leave it empty and a session file is used.
SESSION_STRING=

# Where the database, session files and logs are stored (the Docker image uses /data)
# DATA_DIR=.

# Default for the "remove Forwarded from" setting on first run (1 = on, 0 = off); changeable in the bot menu
# REMOVE_FORWARD_SIGNATURE=1

# Optional: rules imported once on first run when the database is empty.
# After that, manage rules from the bot menu.
# FORWARDING_RULES=-1001111111111:-1002222222222,-1003333333333:-1004444444444
